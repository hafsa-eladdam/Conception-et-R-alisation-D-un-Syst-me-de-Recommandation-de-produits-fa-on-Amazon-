graph GrapheBiparti {
  // Configuration du fond
  bgcolor="#1e293b";
  rankdir=LR;
  pad=0.5;

  // Style global des nœuds (Texte en blanc)
  node [fontname="Arial", fontcolor="white", penwidth=1.5];
  
  // Style global des liens (Gris clair pour la lisibilité)
  edge [color="#94a3b8", penwidth=1.2];

  // Nœuds Utilisateurs (Bleu plus doux pour le fond sombre)
